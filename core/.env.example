# Plantilla de variables de entorno de Orbith.
#
# Copia este archivo como `core/.env` y rellena los valores reales.
# `core/.env` esta ignorado por git a proposito: nunca debe subirse al repositorio.

# Clave criptografica de Django. Genera una nueva y unica por instalacion:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True solo en desarrollo. En produccion SIEMPRE False.
DEBUG=True

# Base de datos PostgreSQL
DATABASE_NAME=orbith_db
DATABASE_USER=postgres
DATABASE_PASSWORD=cambia-esta-contrasena
DATABASE_HOST=localhost
DATABASE_PORT=5432
