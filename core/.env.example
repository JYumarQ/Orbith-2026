# Plantilla de variables de entorno de Orbith.
#
# Copia este archivo como `core/.env` y rellena los valores reales.
# `core/.env` esta ignorado por git a proposito: nunca debe subirse al repositorio
# ni viajar en los paquetes de actualizacion. Al actualizar el servidor se copia
# el `core/.env` de la version anterior (lo hace despliegue/actualizar.sh en la fase 2).
# Esta plantilla solo hace falta para montar Orbith en un servidor NUEVO.

# Clave criptografica de Django. Genera una nueva y unica por instalacion:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# No la cambies en un servidor que ya funciona: se cerrarian las sesiones de todos.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True solo en desarrollo. En el servidor SIEMPRE False (si falta, Orbith usa False).
DEBUG=False

# Base de datos PostgreSQL
DATABASE_NAME=orbith_db
DATABASE_USER=postgres
DATABASE_PASSWORD=cambia-esta-contrasena
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Opcional. Carpeta de las fotos de los usuarios FUERA de la carpeta de la version,
# para que ninguna actualizacion las toque. Sin esta linea van en <carpeta>/media.
# MEDIA_DIR=/srv/orbith_media

# Opcional. Carpeta del registro de errores. Sin esta linea va en <carpeta>/logs.
# LOG_DIR=/srv/orbith_logs
