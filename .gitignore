.venv/
.idea/
.vscode/
__pycache__/
*.pyc
orbith_db.sqlite3
media/
static_root/

# Salida de `manage.py collectstatic`: se genera en cada despliegue, no se versiona.
# Estaba en git y se quedo desactualizada (le faltaban 12 ficheros de static/,
# entre ellos js/progreso_guia.js y css/mobile-ux.css, que carga toda la app),
# asi que en produccion esos recursos daban 404. Ahora el despliegue TIENE que
# ejecutar:  python manage.py collectstatic --noinput
staticfiles/

# Credenciales: nunca deben viajar en el repositorio.
# `core/.env` guarda SECRET_KEY y los datos de la base de datos.
.env
*.env
core/.env

# Copias de trabajo que crea automaticamente el agente de Claude Code.
.claude/worktrees/

# Binario de Cloudflare Tunnel: se descarga, no se versiona.
cloudflared.exe

# Volcados y respaldos de la base de datos. NUNCA al repositorio: contienen
# datos personales de los trabajadores (carnet de identidad, direccion,
# telefono, salario). Una vez commiteados quedan en el historial para siempre,
# aunque despues se borren, y este repositorio tiene remoto en GitHub.
# Guardalos fuera del proyecto o en una carpeta ignorada.
*.dump
*.sql.gz
backup_*.json
*_backup.json
respaldos/
